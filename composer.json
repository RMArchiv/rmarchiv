{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.0",
        "ext-zip": "*",
        "api-ecosystem-for-laravel/dingo-api": "^4.0",
        "barryvdh/laravel-debugbar": "^3.1",
        "barryvdh/laravel-ide-helper": "^3.0",
        "cmgmyr/messenger": "^2.13",
        "cybercog/laravel-ban": "^4.7",
        "diglactic/laravel-breadcrumbs": "^v9.0.0",
        "doctrine/dbal": "^3.0",
        "eusonlito/laravel-meta": "^3.0",
        "filp/whoops": "^2.1",
        "gabrielelana/byte-units": "^0.4.0",
        "genealabs/laravel-model-caching": "^11.0",
        "geoip/geoip": "^1.17",
        "graham-campbell/exceptions": "^17.2",
        "graham-campbell/markdown": "^v15.0.0",
        "intervention/image": "^2.5",
        "irazasyed/telegram-bot-sdk": "^3.6",
        "khill/lavacharts": "4.0.x-dev",
        "kyslik/column-sortable": "^6.4",
        "laravel-notification-channels/discord": "^1.3.0",
        "laravel-notification-channels/telegram": "^5.0.0",
        "laravel/framework": "^11.0",
        "laravel/scout": "^10.0",
        "laravel/ui": "^4.0",
        "lithiumdev/laravel-tagcloud": "^1.0",
        "mdurrant/php-binary-reader": "^1.0",
        "mews/captcha": "^3.2",
        "msurguy/honeypot": "^1.0",
        "nunomaduro/collision": "^8.1",
        "optimus/fineuploader-server": "^0.4.1",
        "predis/predis": "^2.1",
        "robbrazier/piwik": "^2.1",
        "santigarcor/laratrust": "^8.0",
        "spatie/laravel-activitylog": "^4.0",
        "spatie/laravel-cookie-consent": "^3.2",
        "symfony/http-client": "^7.2",
        "symfony/mailgun-mailer": "^7.1",
        "teamtnt/laravel-scout-tntsearch-driver": "^15.0",
        "venturecraft/revisionable": "^1.0",
        "wapmorgan/unified-archive": "^0.0.8",
        "watson/sitemap": "^5.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "0.9.*",
        "phpunit/phpunit": "^10.0",
        "symfony/css-selector": "3.1.*",
        "symfony/dom-crawler": "3.1.*",
        "reliese/laravel": "^v1.1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/TestCase.php"
        ]
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ],
        "post-install-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postInstall"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "php artisan ide-helper:generate",
            "php artisan ide-helper:meta"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
